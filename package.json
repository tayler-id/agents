{
  "name": "agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api": "node --env-file=.env server/api.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "check": "node test/names.ts && npm run typecheck && npm run lint && node test/all.ts",
    "check:names": "node test/names.ts",
    "check:step0": "node --env-file=.env --env-file=.env.test test/step0.ts",
    "check:step1": "node --env-file=.env --env-file=.env.test test/step1.ts",
    "check:step10": "node --env-file=.env --env-file=.env.test test/step10.ts",
    "check:step10b": "node --env-file=.env --env-file=.env.test test/step10b.ts",
    "check:step2": "node --env-file=.env --env-file=.env.test test/step2.ts",
    "check:step2b": "node --env-file=.env --env-file=.env.test test/step2b.ts",
    "check:step3": "node --env-file=.env --env-file=.env.test test/step3.ts",
    "check:step4a": "node --env-file=.env --env-file=.env.test test/step4a.ts",
    "check:step4b": "node --env-file=.env --env-file=.env.test test/step4b.ts",
    "check:step4c": "node --env-file=.env --env-file=.env.test test/step4c.ts",
    "check:step4d": "node --env-file=.env --env-file=.env.test test/step4d.ts",
    "check:step5": "node --env-file=.env --env-file=.env.test test/step5.ts",
    "check:step6": "node --env-file=.env --env-file=.env.test test/step6.ts",
    "check:step6b": "node --env-file=.env --env-file=.env.test test/step6b.ts",
    "check:step7": "node --env-file=.env --env-file=.env.test test/step7.ts",
    "check:step8": "node --env-file=.env --env-file=.env.test test/step8.ts",
    "check:step9": "node --env-file=.env --env-file=.env.test test/step9.ts",
    "check:step9b": "node --env-file=.env --env-file=.env.test test/step9b.ts",
    "daemon": "node daemon/agentsd.ts",
    "desktop": "electron desktop/main.cjs",
    "lint": "eslint .",
    "migrate": "node --env-file=.env server/migrate.ts",
    "migrate:test": "node --env-file=.env --env-file=.env.test server/migrate.ts",
    "typecheck": "tsc && tsc -p app"
  },
  "dependencies": {
    "@durable-streams/client": "^0.2.7",
    "@durable-streams/server": "^0.3.9",
    "@electric-sql/client": "^1.5.28",
    "@electric-sql/react": "^1.0.57",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "8.21.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
